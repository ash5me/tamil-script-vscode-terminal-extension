{
    "compilerOptions": {
        "module": "Node16",
        "target": "es2020",
        "outDir": "out",
        "lib": ["es2020", "es2022", "dom"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noImplicitAny": true,
        "moduleResolution": "node16",
        "types": ["node"],
        "removeComments": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}